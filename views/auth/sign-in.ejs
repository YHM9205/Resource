<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Auto-Code | Sign in</title>
    <link rel="stylesheet" href="/css/auth.css">
</head>
<body>
    <header class="auth-header">
        <a class="brand" href="/">Auto<span>-Code</span></a>
        <%- include('../partials/navbar') %>
    </header>
    <main class="auth-layout">
        <section class="auth-copy"><p class="eyebrow">Welcome back</p><h1>Know your car<br><em>with confidence.</em></h1><p>Sign in to save your vehicles, diagnostic results, and repair history.</p></section>
        <form class="auth-card" method="post" action="/auth/sign-in">
            <input type="hidden" name="next" value="<%= next %>">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <h2>Sign in</h2>
            <% if (error) { %><p class="form-error"><%= error %></p><% } %>
            <% if (message) { %><p class="form-message"><%= message %></p><% } %>
            <label for="username">Username</label>
            <input id="username" name="username" type="text" autocomplete="username" required>
            <label for="password">Password</label>
            <input id="password" name="password" type="password" required>
            <button type="submit">Sign in</button>
            <p>New to Auto-Code? <a href="/auth/sign-up">Create your account</a></p>
        </form>
    </main>
</body>
</html>
