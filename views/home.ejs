<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Auto-Code | Know Before You Pay</title>
    <link rel="stylesheet" href="/css/home.css">
</head>
<body>
    <header class="site-header">
        <a class="brand" href="/">Auto<span>-Code</span></a>
        <nav class="main-nav" aria-label="Main navigation">
            <a href="/">Home</a>
            <a href="/garage">Garage</a>
            <a href="/system">Diagnostic System</a>
        </nav>
        <div class="account-actions">
            <% if (user) { %>
                <span class="welcome-user">Hi, <%= user.username %></span>
                <a href="/settings">Settings</a>
                <a class="register-link" href="/auth/sign-out">Sign out</a>
            <% } else { %>
                <a href="/auth/sign-in">Existing user? Sign in</a>
                <a class="register-link" href="/auth/sign-up">New user? Register</a>
            <% } %>
        </div>
    </header>

    <main class="home-content">
        <section class="welcome" aria-labelledby="welcome-title">
            <p class="eyebrow">Vehicle knowledge, before the workshop</p>
            <h1 id="welcome-title">Know your car<br><em>before you pay.</em></h1>
            <p class="intro">Understand the problem, check the parts, and walk into the garage with confidence.</p>
        </section>

        <section class="services" aria-label="Auto-Code services">
            <a class="service-card card-garage" href="<%= user ? '/garage' : '/auth/sign-up?next=%2Fgarage' %>">
                <span class="card-number">01</span>
                <span class="card-icon" aria-hidden="true">◌</span>
                <h2>My Garage</h2>
                <p>Keep your cars and maintenance history in one place.</p>
                <span class="card-action">Open garage <span aria-hidden="true">↗</span></span>
            </a>

            <a class="service-card card-diagnostic" href="<%= user ? '/system' : '/auth/sign-up?next=%2Fsystem' %>">
                <span class="card-number">02</span>
                <span class="card-icon" aria-hidden="true">⌁</span>
                <h2>Diagnostic System</h2>
                <p>Read error codes and understand what they may mean.</p>
                <span class="card-action">Check diagnostics <span aria-hidden="true">↗</span></span>
            </a>

            <a class="service-card card-parts" href="<%= user ? '/parts' : '/auth/sign-up?next=%2Fparts' %>">
                <span class="card-number">03</span>
                <span class="card-icon" aria-hidden="true">+</span>
                <h2>Parts &amp; Maintenance</h2>
                <p>Find compatible parts and learn what the repair involves.</p>
                <span class="card-action">Explore parts <span aria-hidden="true">↗</span></span>
            </a>
        </section>

        <p class="login-note"><%= user ? 'Your account is active. Open a service to continue.' : 'Create a free account to use the garage, diagnostics, and parts tools.' %></p>
    </main>
</body>
</html>
